/*******************************************************************************
 * ROFI Color theme
 * User: Lairizzle
 * Copyright: Lairizzle
 ********************************************************************************/

* {
    selected-normal-foreground:  rgba(213, 196, 161, 1);     /* light fg (gruvbox light2) */
    foreground:                  rgba(235, 219, 178, 1);     /* fg */
    normal-foreground:           @foreground;

    alternate-normal-background: rgba(40, 40, 40, 1);        /* #282828 */
    red:                         rgba(204, 36, 29, 1);        /* #cc241d (gruvbox red) */
    selected-urgent-foreground:  rgba(204, 36, 29, 1);

    blue:                        rgba(69, 133, 136, 1);       /* #458588 (gruvbox blue/aqua tone) */
    urgent-foreground:           rgba(204, 36, 29, 1);
    alternate-urgent-background: rgba(40, 40, 40, 1);        /* #282828 */

    active-foreground:           rgba(146, 131, 116, 1);      /* #928374 (gruvbox gray) */
    lightbg:                     rgba(60, 56, 54, 1);         /* #3c3836 */

    selected-active-foreground:  rgba(213, 196, 161, 1);
    alternate-active-background: rgba(40, 40, 40, 1);

    background:                  rgba(40, 40, 40, 0.93);       /* gruvbox bg */
    bordercolor:                 rgba(168, 153, 132, 1);       /* #a89984 */

    alternate-normal-foreground: @foreground;
    normal-background:           rgba(60, 56, 54, 0.06);       /* subtle bg */

    lightfg:                     rgba(235, 219, 178, 1);       /* fg again */

    selected-normal-background:  rgba(50, 48, 47, 1);          /* #32302f */

    border-color:                @bordercolor;
    spacing:                     2;

    separatorcolor:              rgba(50, 48, 47, 1);          /* #32302f */

    urgent-background:           rgba(40, 40, 40, 1);          /* bg */
    selected-urgent-background:  rgba(204, 36, 29, 1);         /* red */

    alternate-urgent-foreground: @urgent-foreground;

    background-color:            rgba(0, 0, 0, 0);

    alternate-active-foreground: @active-foreground;
    active-background:           rgba(40, 40, 40, 1);

    selected-active-background:  rgba(50, 48, 47, 1);          /* #32302f */
}

window {
    background-color: @background;
    border:0;
    border-radius:8px;
    padding: 5;
    width: 60%;
    height:	60%;
}
mainbox {
    border:  0;
    padding: 5px;
}
message {
    border:       2px 0px 0px ;
    border-color: @separatorcolor;
    padding:      1px ;
}
textbox {
    text-color: @foreground;
}
listview {
    fixed-height: 0;
    border:       none;
    border-color: @separatorcolor;
    spacing:      4px ;
    scrollbar:    true;
    padding:      2px 0px 0px ;
}
element {
    border:  0;
    padding: 7px ;
}
element-text {
    background-color: inherit;
    text-color:       inherit;
}
element.normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}
element.normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
element.normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}
element.selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}
element.selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}
element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color:       @alternate-normal-foreground;
}
element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color:       @alternate-urgent-foreground;
}
element.alternate.active {
    background-color: @alternate-active-background;
    text-color:       @alternate-active-foreground;
}
scrollbar {
    width:        2px ;
    border:       0;
    handle-width: 8px ;
    padding:      0;
}
mode-switcher {
    border:       2px 0px 0px ;
    border-color: @separatorcolor;
}
button.selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
inputbar {
    spacing:    0;
    text-color: @normal-foreground;
    padding: 10px 5px ;
}
case-indicator {
    spacing:    0;
    text-color: @normal-foreground;
}
entry {
    spacing:    0;
    text-color: @normal-foreground;
}
prompt {
    spacing:    0;
    text-color: @normal-foreground;
}
inputbar {
    children:   [ prompt,textbox-prompt-colon,entry,case-indicator ];
}
textbox-prompt-colon {
    expand:     false;
    str:        ":";
    margin:     0px 0.3em 0em 0em ;
    text-color: @normal-foreground;
}
scrollbar {
    width:        4px;
    border:       0;
    handle-width: 8px;
    padding:      0;
    handle-color: @blue;
}
